# Same Supabase project as the service side (the sales tables live there too).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Use a different one from the service backend.
JWT_SECRET=

PORT=4000
# Comma-separated dashboard URLs allowed to call this API (empty = any).
CORS_ORIGINS=

# WhatsApp Cloud API number that sends login codes (e.g. 8855000091).
# Leave empty locally: codes are printed to the server log instead.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
OTP_TEMPLATE=login_otp
OTP_TEMPLATE_LANG=en
